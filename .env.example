# Environment Configuration for TravelGenius AI
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=travelgenius-secret-key-change-in-production-2025

# Gemini API Key (Get yours for free at https://aistudio.google.com/)
# If left empty, the application will run in Demo Mode with realistic sample itineraries
GEMINI_API_KEY=

# Optional Gemini Model selection (default: gemini-2.5-flash or gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash
